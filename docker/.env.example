# carddav2fritzbox — sample environment file for Swarm deployment
#
# Copy to docker/.env (or project-root .env) and edit:
#   cp docker/.env.example docker/.env
#   # or: cp docker/.env.example .env
# docker compose / docker stack deploy and docker/deploy.sh read these
# variables via compose interpolation (${VAR:-default}). See
# docker/docker-compose.yml and docker/deploy.sh for defaults.
#
# IMPORTANT: Secrets must NOT be placed here. Passwords (FRITZBOX_PASSWORD,
# CARDDAV_*_PASSWORD, FTP_PASSWORD, SMTP_PASSWORD) are supplied exclusively
# as Docker Swarm secrets via `docker secret create` or interactively via
# docker/deploy.sh (see specs/002-docker-swarm-deployment/contracts/env-secrets.md).
# The real .env file (with any non-secret values you set) is git-ignored via
# .gitignore .env* (constitution V / FR-013).
#
# ----------------------------------------------------------------------
# Stack / image
# ----------------------------------------------------------------------
# Name of the Swarm stack (deploy.sh: STACK_NAME)
STACK_NAME=carddav2fritzbox

# Container image reference. For single-host use the locally built tag;
# for a heterogeneous Swarm (amd64+arm64) this MUST be a registry manifest
# list pushed via docker/build.sh --push (see docker/swarm.md §1)
SYNC_IMAGE=carddav2fritzbox:local
# SYNC_IMAGE=registry.example.com/carddav2fritzbox:1.0

# Path to the non-secret config.ini on the deploy host, shipped as a Swarm
# config (docker-compose.yml: SYNC_CONFIG_PATH, default ./config.ini)
SYNC_CONFIG_PATH=./config.ini

# Comma-separated list of secrets the wrapper expects to exist at
# /run/secrets/<name> and fails fast with exit 2 if absent (FR-014)
# Must match secrets declared in docker-compose.yml and created via deploy.sh
SYNC_EXPECTED_SECRETS=fritzbox_password
# SYNC_EXPECTED_SECRETS=fritzbox_password,carddav_1_password,carddav_2_password,smtp_password

# ----------------------------------------------------------------------
# Scheduling
# ----------------------------------------------------------------------
# Cron expression for the swarm-cronjob trigger (docker-compose.yml label
# swarm.cronjob.schedule, default "0 3 * * *" — nightly at 03:00)
SYNC_CRON=0 3 * * *
# SYNC_CRON=30 4 * * *        # 04:30 daily
# SYNC_CRON=0 */6 * * *       # every 6 hours

# Timezone for both the sync service and the swarm-cronjob sidecar
# (docker-compose.yml: TIMEZONE, default Europe/Amsterdam)
TIMEZONE=Europe/Amsterdam
# TIMEZONE=Europe/Berlin

# ----------------------------------------------------------------------
# Failure notifications (optional — disabled when SMTP_HOST/EMAIL_FROM/EMAIL_TO unset)
# ----------------------------------------------------------------------
# SMTP transport (contracts/env-secrets.md wrapper-only variables)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=mailer
# SMTP_PASSWORD is a secret, not an env var — create secret `smtp_password`
EMAIL_FROM=sync@example.com
EMAIL_TO=admin@example.com
